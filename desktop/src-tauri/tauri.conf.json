{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sniff",
  "version": "0.1.0",
  "identifier": "pk.edu.nu.sniff",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Sniff", "width": 760, "height": 480, "decorations": false, "resizable": false, "skipTaskbar": true, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "../build/sniff-backend/": "backend/", "../build/llama/": "llama/" },
    "useLocalToolsDir": true,
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  }
}
